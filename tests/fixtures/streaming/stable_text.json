      "description": "A partial or final with an explicit null stable_text fails construction.",
      "events": [
        {"type": "partial", "segment_id": "s0", "text": "hello", "stable_text": null, "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "hello", "stable_text": null, "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "hello", "stable_text": "hello", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "done", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}}
      ],
      "expected": {
        "events": [
          {"outcome": "invalid", "diagnostics": []},
          {"outcome": "invalid", "diagnostics": []},
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hello"},
          {"outcome": "admitted", "diagnostics": []}
        ],
        "display": [["s0", "hello"]],
        "result_segments": ["hello"],
        "result_text": "hello"
      }
    },
    {
