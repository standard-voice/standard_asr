        {"type": "partial", "segment_id": "s0", "text": "the cat", "stable_text": "the ", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "partial", "segment_id": "s0", "text": "a dog", "stable_text": "", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "the cattle", "stable_text": "the cattle", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
