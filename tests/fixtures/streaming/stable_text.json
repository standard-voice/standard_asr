{
  "description": "Shared stable-text cases for the streaming protocol. Each case lists wire-shaped events in emission order and what the lifecycle guard does with each. The cases are replayed through the lifecycle guard, the session's reducer, and the reference reduce, not through a session. The guard is given no capabilities, so no case records a capability code (stream_exceeds_*, finality_level_not_reached); a guard that has an engine's capabilities, as in a session that an engine opened, can record more codes for the same events. Every event writes out finality, old_ids, new_ids, and extra, the keys whose default is not null, and every partial and final writes out stable_text. Every other key that an event leaves out is null, such as segment_id, text, and stable_text on a done event. The outcome of an event is 'admitted' (the guard forwards it), 'rejected' (the guard suppresses it), or 'invalid' (malformed: it fails event construction and never reaches the guard). The fixture runner skips an invalid event and goes on to the next one; in a session, an engine that fails to construct an event ends the session with engine_error. A partial or a final is invalid when its stable_text is null, is not the start of its text, or, on a final, is not the whole text. An admitted partial or final gives the stable_text as the guard forwards it, which can differ from the one sent; an admitted event of another type gives none, because it carries null. 'diagnostics' lists the codes recorded while handling that event, in order. 'display' is the reading-order list of [segment_id, text] pairs that the reference reduce keeps, partial text included; 'result_segments' are the texts of the finalized segments in the reduced result; 'result_text' is given for cases with at most one finalized segment only, because how segment texts are joined is not settled (issue #46). 'group' names the rule a case depends on: 'core', 'final' (a final is wholly stable), or 'supersede' (a supersede withdraws the retired segments, stable text included). The boundary cases cover only what the standard layer checks, that stable text does not end inside a combining character sequence or right after a zero width joiner; they do not cover the full rule that stable text ends between two user-perceived characters.",
  "cases": [
    {
      "name": "growth",
      "group": "core",
      "description": "Stable text grows from event to event; the final is stable as a whole.",
      "events": [
        {"type": "partial", "segment_id": "s0", "text": "hel", "stable_text": "", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "partial", "segment_id": "s0", "text": "hello wor", "stable_text": "hello ", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "hello world", "stable_text": "hello world", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "done", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}}
      ],
      "expected": {
        "events": [
          {"outcome": "admitted", "diagnostics": [], "stable_text": ""},
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hello "},
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hello world"},
          {"outcome": "admitted", "diagnostics": []}
        ],
        "display": [["s0", "hello world"]],
        "result_segments": ["hello world"],
        "result_text": "hello world"
      }
    },
    {
      "name": "empty_stable_text",
      "group": "core",
      "description": "A partial with an empty stable text promises nothing.",
      "events": [
        {"type": "partial", "segment_id": "s0", "text": "hello", "stable_text": "", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "hello", "stable_text": "hello", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "done", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}}
      ],
      "expected": {
        "events": [
          {"outcome": "admitted", "diagnostics": [], "stable_text": ""},
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hello"},
          {"outcome": "admitted", "diagnostics": []}
        ],
        "display": [["s0", "hello"]],
        "result_segments": ["hello"],
        "result_text": "hello"
      }
    },
    {
      "name": "shrink_is_clamped",
      "group": "core",
      "description": "A partial whose stable text is shorter than before is delivered with the earlier stable text.",
      "events": [
        {"type": "partial", "segment_id": "s0", "text": "hello", "stable_text": "hell", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "partial", "segment_id": "s0", "text": "hello!", "stable_text": "he", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "partial", "segment_id": "s0", "text": "hello!!", "stable_text": "", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "final", "segment_id": "s0", "text": "hello!!", "stable_text": "hello!!", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
        {"type": "done", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}}
      ],
      "expected": {
        "events": [
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hell"},
          {"outcome": "admitted", "diagnostics": ["stable_text_clamped"], "stable_text": "hell"},
          {"outcome": "admitted", "diagnostics": ["stable_text_clamped"], "stable_text": "hell"},
          {"outcome": "admitted", "diagnostics": [], "stable_text": "hello!!"},
          {"outcome": "admitted", "diagnostics": []}
        ],
        "display": [["s0", "hello!!"]],
        "result_segments": ["hello!!"],
        "result_text": "hello!!"
      }
    },
    {
      "name": "non_prefix_is_invalid",
      "group": "core",
      "description": "A stable text that is not a prefix of the text fails construction. The fixture runner goes on to the next event; in a session, an engine that fails to construct an event ends the session with engine_error.",
      "events": [
        {"type": "partial", "segment_id": "s0", "text": "hello", "stable_text": "help", "finality": "final", "old_ids": [], "new_ids": [], "extra": {}},
